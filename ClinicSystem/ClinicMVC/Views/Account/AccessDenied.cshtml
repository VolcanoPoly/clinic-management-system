@*
    Author      : Ali Alsaffar
    Student ID  : 202301152
    Stage       : Stage 3 - Authentication & Identity
    Description : Shown when an authenticated user tries to reach a page their role is not permitted to access.
*@
@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center mt-5 py-5">
    <div class="mb-3">
        <i class="fa-solid fa-shield-halved text-danger" style="font-size:4rem;"></i>
    </div>
    <h1 class="text-danger fw-bold">Access Denied</h1>
    <p class="lead text-muted">You do not have permission to view this page (403).</p>
    <p class="text-muted small">If you believe this is a mistake, sign in with the correct role or contact your clinic administrator.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        <i class="fa-solid fa-house me-1"></i> Return to Home
    </a>
</div>
