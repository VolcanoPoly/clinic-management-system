    Stage       : Stage 3 - Authentication & Identity
    Description : Shown when an authenticated user tries to reach a page their role is not permitted to access.
*@
@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center mt-5">
    <h1 class="display-1 text-danger"><i class="bi bi-exclamation-triangle"></i></h1>
    <h1 class="text-danger">Access Denied</h1>
    <p class="lead">You do not have permission to view this page.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Return to Home</a>
</div>
