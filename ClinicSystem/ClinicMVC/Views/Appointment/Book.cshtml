@model ClinicMVC.Models.ViewModels.AppointmentBookViewModel
@{
    ViewData["Title"] = "Book Appointment";
    bool isReceptionist = User.IsInRole("Receptionist");
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <h2 class="mb-1">Book an Appointment</h2>
            <p class="text-muted mb-4">Step 1 of 4 — Select a specialization</p>

            <div class="progress mb-4" style="height:6px">
                <div class="progress-bar" style="width:25%"></div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="SelectDoctor" method="post">
                        @Html.AntiForgeryToken()

                        @if (isReceptionist)
                        {
                            <div class="mb-3">
                                <label asp-for="PatientId" class="form-label fw-semibold">Patient</label>
                                <select asp-for="PatientId" asp-items="Model.Patients"
                                        class="form-select" required>
                                    <option value="">— Select patient —</option>
                                </select>
                            </div>
                        }

                        <div class="mb-4">
                            <label asp-for="SpecializationId" class="form-label fw-semibold">Specialization</label>
                            <select asp-for="SpecializationId" asp-items="Model.Specializations"
                                    class="form-select form-select-lg">
                                <option value="">— Select specialization —</option>
                            </select>
                            <span asp-validation-for="SpecializationId" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            Next: Choose Doctor &rarr;
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
