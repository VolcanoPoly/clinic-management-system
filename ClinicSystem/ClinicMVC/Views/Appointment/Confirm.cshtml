@model ClinicMVC.Models.ViewModels.AppointmentConfirmViewModel
@{
    ViewData["Title"] = "Confirm Appointment";
    bool isReceptionist = User.IsInRole("Receptionist");
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <h2 class="mb-1">Confirm Your Appointment</h2>
            <p class="text-muted mb-2">Step 4 of 4 — Review and confirm</p>

            <div class="progress mb-4" style="height:6px">
                <div class="progress-bar" style="width:100%"></div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th class="text-muted" style="width:40%">Specialization</th>
                            <td><strong>@Model.SpecializationName</strong></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Doctor</th>
                            <td><strong>@Model.DoctorName</strong></td>
                        </tr>
                        @if (isReceptionist && !string.IsNullOrEmpty(Model.PatientName))
                        {
                            <tr>
                                <th class="text-muted">Patient</th>
                                <td><strong>@Model.PatientName</strong></td>
                            </tr>
                        }
                        <tr>
                            <th class="text-muted">Date</th>
                            <td><strong>@Model.AppointmentDateTime.ToString("dddd, dd MMMM yyyy")</strong></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Time</th>
                            <td><strong>@Model.AppointmentDateTime.ToString("hh:mm tt")</strong></td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(Model.Notes))
                        {
                            <tr>
                                <th class="text-muted">Notes</th>
                                <td>@Model.Notes</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>

            <div class="alert alert-info small">
                Your appointment will be submitted as <strong>Requested</strong>.
                A receptionist will confirm it shortly.
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SpecializationId" value="@Model.SpecializationId" />
                <input type="hidden" name="SpecializationName" value="@Model.SpecializationName" />
                <input type="hidden" name="DoctorId" value="@Model.DoctorId" />
                <input type="hidden" name="DoctorName" value="@Model.DoctorName" />
                <input type="hidden" name="PatientId" value="@Model.PatientId" />
                <input type="hidden" name="PatientName" value="@Model.PatientName" />
                <input type="hidden" name="AppointmentDateTime" value="@Model.AppointmentDateTime.ToString("o")" />
                <input type="hidden" name="Notes" value="@Model.Notes" />

                <div class="d-flex gap-2">
                    <button type="button" onclick="history.back()" class="btn btn-outline-secondary">&larr; Back</button>
                    <button type="submit" class="btn btn-success btn-lg flex-grow-1">
                        Confirm Appointment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
