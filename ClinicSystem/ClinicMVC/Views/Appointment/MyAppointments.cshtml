@model List<ClinicMVC.Models.ViewModels.AppointmentListItemViewModel>
@{
    ViewData["Title"] = "My Appointments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My Appointments</h2>
        <a asp-action="Book" class="btn btn-primary">+ Book New Appointment</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">You have no appointments yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Doctor</th>
                        <th>Specialization</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.AppointmentDateTime.ToString("dd MMM yyyy") <br /><small class="text-muted">@a.AppointmentDateTime.ToString("hh:mm tt")</small></td>
                            <td>@a.DoctorName</td>
                            <td>@a.SpecializationName</td>
                            <td>@Html.Partial("_StatusBadge", a.Status)</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">View</a>
                                @if (a.Status == ClinicAPI.Models.AppointmentStatus.Requested ||
                                     a.Status == ClinicAPI.Models.AppointmentStatus.Confirmed)
                                {
                                    <button class="btn btn-sm btn-outline-danger ms-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#cancelModal"
                                            data-id="@a.Id">
                                        Cancel
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="cancelId" />
                <div class="modal-header">
                    <h5 class="modal-title">Cancel Appointment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Reason (optional)</label>
                    <textarea name="reason" class="form-control" rows="2" placeholder="Reason for cancellation..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">Confirm Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('cancelModal').addEventListener('show.bs.modal', function (e) {
        document.getElementById('cancelId').value = e.relatedTarget.dataset.id;
    });
</script>
}
