@*
    Author      : Ali Alsaffar
    Student ID  : 202301152
    Stage       : Stage 6 - Appointment Lifecycle Management
    Description : Step 3: shows available 30-minute time slots for the selected doctor and date for the patient to pick.
*@
@model ClinicMVC.Models.ViewModels.AppointmentSelectSlotViewModel
@{
    ViewData["Title"] = "Choose Date & Time";
}

<div class="container mt-4">
    <h2 class="mb-1">Choose Date &amp; Time</h2>
    <p class="text-muted mb-2">
        Step 3 of 4 — @Model.DoctorName &nbsp;|&nbsp; @Model.SpecializationName
    </p>

    <div class="progress mb-4" style="height:6px">
        <div class="progress-bar" style="width:75%"></div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Confirm" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SpecializationId" value="@Model.SpecializationId" />
        <input type="hidden" name="SpecializationName" value="@Model.SpecializationName" />
        <input type="hidden" name="DoctorId" value="@Model.DoctorId" />
        <input type="hidden" name="DoctorName" value="@Model.DoctorName" />
        <input type="hidden" name="PatientId" value="@Model.PatientId" />

        <div class="row g-4">
            <div class="col-md-5">
                <label class="form-label fw-semibold">Appointment Date</label>
                <input type="date" name="Date" id="datePicker"
                       value="@Model.Date.ToString("yyyy-MM-dd")"
                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                       class="form-control form-control-lg" required />
            </div>

            <div class="col-md-7">
                <label class="form-label fw-semibold">Available Time Slots</label>
                <div id="slotsContainer">
                    @if (!Model.AvailableSlots.Any())
                    {
                        <p class="text-muted" id="noSlots">No available slots on this date. Please choose another day.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2" id="slotsGrid">
                            @foreach (var slot in Model.AvailableSlots)
                            {
                                <div>
                                    <input type="radio" class="btn-check" name="SelectedSlot"
                                           id="slot_@slot.Replace(":", "")" value="@slot"
                                           @(slot == Model.SelectedSlot ? "checked" : "") />
                                    <label class="btn btn-outline-primary" for="slot_@slot.Replace(":", "")">
                                        @slot
                                    </label>
                                </div>
                            }
                        </div>
                    }
                </div>
                <input type="hidden" name="SelectedSlot" id="selectedSlotHidden" value="@Model.SelectedSlot" />
                <span asp-validation-for="SelectedSlot" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label fw-semibold">Notes <span class="text-muted fw-normal">(optional)</span></label>
            <textarea name="Notes" class="form-control" rows="2"
                      placeholder="Describe your symptoms or reason for visit...">@Model.Notes</textarea>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="button" onclick="history.back()" class="btn btn-outline-secondary">&larr; Back</button>
            <button type="submit" class="btn btn-primary">Next: Confirm &rarr;</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    const docId = @Model.DoctorId;

    document.getElementById('datePicker').addEventListener('change', async function () {
        const date = this.value;
        if (!date) return;

        const res = await fetch(`/Appointment/GetSlots?doctorId=${docId}&date=${date}`);
        const slots = await res.json();
        const container = document.getElementById('slotsContainer');

        if (!slots || slots.length === 0) {
            container.innerHTML = '<p class="text-muted" id="noSlots">No available slots on this date. Please choose another day.</p>';
            return;
        }

        let html = '<div class="d-flex flex-wrap gap-2" id="slotsGrid">';
        slots.forEach(slot => {
            const id = 'slot_' + slot.replace(':', '');
            html += `<div>
                <input type="radio" class="btn-check" name="SelectedSlot" id="${id}" value="${slot}" />
                <label class="btn btn-outline-primary" for="${id}">${slot}</label>
            </div>`;
        });
        html += '</div>';
        container.innerHTML = html;
    });
</script>
}
