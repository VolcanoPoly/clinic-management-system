@*
    Author      : Ali Alsaffar
    Student ID  : 202301152
    Stage       : Stage 6 - Appointment Lifecycle Management
    Description : Today's appointments summary view used by receptionists to quickly see and manage the day's schedule.
*@
@model List<ClinicMVC.Models.ViewModels.AppointmentListItemViewModel>
@{
    ViewData["Title"] = "Today's Appointments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Today's Appointments</h2>
            <p class="text-muted mb-0">@DateTime.Today.ToString("dddd, dd MMMM yyyy")</p>
        </div>
        <a asp-action="Book" class="btn btn-primary">+ Book for Patient</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null)   { <div class="alert alert-danger">@TempData["Error"]</div> }

    @if (!Model.Any())
    {
        <div class="alert alert-info">No appointments scheduled for today.</div>
    }
    else
    {
        <div id="waiting-room-message" class="alert alert-success d-none"></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Time</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Specialization</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.OrderBy(x => x.AppointmentDateTime))
                    {
                        <tr data-appointment-id="@a.Id">
                            <td><strong>@a.AppointmentDateTime.ToString("hh:mm tt")</strong></td>
                            <td>@a.PatientName</td>
                            <td>@a.DoctorName</td>
                            <td>@a.SpecializationName</td>
                            <td class="status-cell" data-appointment-id="@a.Id">@Html.Partial("_StatusBadge", a.Status)</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Manage</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/%40microsoft/signalr@7.0.12/dist/browser/signalr.min.js"></script>
    <script src="~/js/appointment-waitingroom.js" asp-append-version="true"></script>
}
