@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="welcome-banner doctor-banner" data-aos="fade-down">
    <div class="role-badge"><i class="fa-solid fa-stethoscope"></i> Doctor Portal</div>
    <h1><i class="fa-solid fa-user-doctor me-2"></i> Welcome, Dr. @User.Identity?.Name!</h1>
    <p>Manage your appointments and patient consultations.</p>
</div>

<div class="row g-4">
    <div class="col-md-4" data-aos="fade-up" data-aos-delay="0">
        <a asp-controller="Appointment" asp-action="DoctorAppointments" class="stat-card">
            <div class="stat-icon" style="background:#d1fae5; color:#065f46;">
                <i class="fa-solid fa-calendar-days"></i>
            </div>
            <div class="stat-title">My Appointments</div>
            <div class="stat-value">Today &amp; Upcoming</div>
            <div class="stat-desc">View all your scheduled patient consultations.</div>
            <div class="stat-action" style="color:#059669;">View Schedule <i class="fa-solid fa-arrow-right"></i></div>
        </a>
    </div>

    <div class="col-md-4" data-aos="fade-up" data-aos-delay="80">
        <a asp-controller="Doctor" asp-action="MyVisitRecords" class="stat-card">
            <div class="stat-icon" style="background:#dbeafe; color:#1d4ed8;">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="stat-title">Recent Patients</div>
            <div class="stat-value">Patient History</div>
            <div class="stat-desc">Review past consultations and visit records.</div>
            <div class="stat-action" style="color:#2563eb;">View Patients <i class="fa-solid fa-arrow-right"></i></div>
        </a>
    </div>

    <div class="col-md-4" data-aos="fade-up" data-aos-delay="160">
        <a asp-controller="Doctor" asp-action="MyPrescriptions" class="stat-card">
            <div class="stat-icon" style="background:#d1fae5; color:#065f46;">
                <i class="fa-solid fa-file-prescription"></i>
            </div>
            <div class="stat-title">Prescriptions</div>
            <div class="stat-value">Manage Prescriptions</div>
            <div class="stat-desc">View and manage all prescriptions you have issued.</div>
            <div class="stat-action" style="color:#059669;">Manage <i class="fa-solid fa-arrow-right"></i></div>
        </a>
    </div>
</div>
