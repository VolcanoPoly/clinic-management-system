@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="row mt-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-5 text-center bg-primary text-white rounded">
                <h1 class="display-4">Welcome, Doctor!</h1>
                <p class="lead">Manage your schedule and patients here.</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4 g-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <h2 class="h4">Today's Schedule</h2>
                <p class="text-muted">You have 0 appointments scheduled for today.</p>
                <button class="btn btn-primary disabled">View Schedule</button>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <h2 class="h4">Recent Patients</h2>
                <p class="text-muted">No recent patient history to show.</p>
                <button class="btn btn-outline-primary disabled">Patient Search</button>
            </div>
        </div>
    </div>
</div>
