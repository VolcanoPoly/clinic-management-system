@model List<ClinicMVC.Models.ViewModels.PrescriptionViewModel>
@{
    ViewData["Title"] = "My Prescriptions";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Prescriptions</h2>
        <a asp-action="Dashboard" asp-controller="Doctor" class="btn btn-outline-secondary">← Dashboard</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No prescriptions issued yet. Prescriptions are created from a visit record after completing an appointment.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date Issued</th>
                                <th>Medications</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prescription in Model)
                            {
                                <tr>
                                    <td>
                                        @prescription.IssuedAt.ToString("dd MMM yyyy")<br />
                                        <small class="text-muted">@prescription.IssuedAt.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        @prescription.Items.Count medication(s):
                                        <small class="text-muted">@string.Join(", ", prescription.Items.Select(i => i.MedicationName))</small>
                                    </td>
                                    <td class="d-flex gap-1">
                                        <a asp-action="ViewPrescription" asp-controller="Doctor" asp-route-id="@prescription.Id" class="btn btn-sm btn-outline-primary">View</a>
                                        <a asp-action="VisitRecordDetail" asp-controller="Doctor" asp-route-id="@prescription.VisitRecordId" class="btn btn-sm btn-outline-secondary">Visit Record</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
