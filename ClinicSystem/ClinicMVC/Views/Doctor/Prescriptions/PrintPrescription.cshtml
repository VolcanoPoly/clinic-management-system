@model ClinicMVC.Models.ViewModels.PrescriptionViewModel
@{
    ViewData["Title"] = "Print Prescription";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Prescription #@Model.Id</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 40px;
            max-width: 800px;
            margin: 0 auto;
        }
        .header {
            text-align: center;
            border-bottom: 3px solid #000;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
        }
        .header p {
            margin: 5px 0 0;
            color: #666;
        }
        .info-section {
            margin-bottom: 30px;
        }
        .info-row {
            display: flex;
            margin-bottom: 10px;
        }
        .info-label {
            font-weight: bold;
            width: 150px;
        }
        .info-value {
            flex: 1;
        }
        .medications {
            margin-top: 30px;
        }
        .medications h3 {
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }
        th {
            background-color: #f5f5f5;
            font-weight: bold;
        }
        .footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            display: flex;
            justify-content: space-between;
        }
        .signature {
            text-align: center;
            width: 200px;
        }
        .signature-line {
            border-top: 1px solid #000;
            margin-top: 60px;
        }
        @@media print {
            body {
                padding: 20px;
            }
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>CLINIC MANAGEMENT SYSTEM</h1>
        <p>Medical Prescription</p>
    </div>

    <div class="info-section">
        <div class="info-row">
            <div class="info-label">Prescription #:</div>
            <div class="info-value">@Model.Id</div>
        </div>
        <div class="info-row">
            <div class="info-label">Date Issued:</div>
            <div class="info-value">@Model.IssuedAt.ToString("dd MMMM yyyy")</div>
        </div>
        <div class="info-row">
            <div class="info-label">Doctor:</div>
            <div class="info-value">@Model.DoctorName</div>
        </div>
    </div>

    <div class="medications">
        <h3>Prescribed Medications</h3>
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Medication Name</th>
                    <th>Dosage</th>
                    <th>Frequency</th>
                    <th>Duration</th>
                    <th>Instructions</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@Model.Items[i].MedicationName</td>
                        <td>@Model.Items[i].Dosage</td>
                        <td>@Model.Items[i].Frequency</td>
                        <td>@Model.Items[i].Duration</td>
                        <td>@Model.Items[i].Instructions</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="footer">
        <div class="signature">
            <p>Doctor's Signature</p>
            <div class="signature-line"></div>
            <p>@Model.DoctorName</p>
        </div>
        <div class="signature">
            <p>Pharmacist Signature</p>
            <div class="signature-line"></div>
            <p>Date: _______________</p>
        </div>
    </div>

    <div class="no-print" style="margin-top: 30px; text-align: center;">
        <button onclick="window.print()" class="btn btn-primary">Print Prescription</button>
        <button onclick="window.close()" class="btn btn-secondary">Close</button>
    </div>
</body>
</html>
