@model ClinicMVC.Models.ViewModels.VisitRecordFormViewModel
@{
    ViewData["Title"] = "Create Visit Record";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Create Visit Record</h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateVisitRecord" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="AppointmentId" />

                        <div class="alert alert-info mb-4">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Patient:</strong> @Model.PatientName
                                </div>
                                <div class="col-md-6">
                                    <strong>Appointment:</strong> @Model.AppointmentDateTime.ToString("dd MMM yyyy HH:mm")
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DoctorNotes" class="form-label">Doctor Notes</label>
                            <textarea asp-for="DoctorNotes" class="form-control" rows="4" required></textarea>
                            <span asp-validation-for="DoctorNotes" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Diagnosis" class="form-label">Diagnosis</label>
                            <input asp-for="Diagnosis" class="form-control" required />
                            <span asp-validation-for="Diagnosis" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Treatment" class="form-label">Treatment</label>
                            <textarea asp-for="Treatment" class="form-control" rows="4" required></textarea>
                            <span asp-validation-for="Treatment" class="text-danger"></span>
                        </div>


                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Create Visit Record</button>
                            <a asp-action="Details" asp-controller="Appointment" asp-route-id="@Model.AppointmentId" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

