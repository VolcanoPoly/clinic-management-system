@model List<ClinicMVC.Models.ViewModels.VisitRecordListItemViewModel>
@{
    ViewData["Title"] = "My Visit History";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">My Visit History</h5>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Doctor</th>
                                        <th>Diagnosis</th>
                                        <th>Prescription</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in Model)
                                    {
                                        <tr>
                                            <td>@record.AppointmentDateTime.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>@record.DoctorName</td>
                                            <td>@record.Diagnosis</td>
                                            <td>
                                                @if (record.HasPrescription)
                                                {
                                                    <span class="badge bg-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">No</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@record.Id" class="btn btn-sm btn-outline-primary">View</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            You have no visit records yet.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
