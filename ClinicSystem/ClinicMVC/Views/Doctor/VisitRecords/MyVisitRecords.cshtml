@model List<ClinicMVC.Models.ViewModels.VisitRecordViewModel>
@{
    ViewData["Title"] = "Patient History";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Patient History</h2>
        <a asp-action="Dashboard" asp-controller="Doctor" class="btn btn-outline-secondary">← Dashboard</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No visit records yet. Visit records are created after completing an appointment.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Patient</th>
                                <th>Diagnosis</th>
                                <th>Prescription</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model)
                            {
                                <tr>
                                    <td>
                                        @record.AppointmentDateTime.ToString("dd MMM yyyy")<br />
                                        <small class="text-muted">@record.AppointmentDateTime.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>@record.PatientName</td>
                                    <td>@record.Diagnosis</td>
                                    <td>
                                        @if (record.HasPrescription)
                                        {
                                            <span class="badge bg-success">Issued</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">None</span>
                                        }
                                    </td>
                                    <td class="d-flex gap-1">
                                        <a asp-action="VisitRecordDetail" asp-controller="Doctor" asp-route-id="@record.Id" class="btn btn-sm btn-outline-primary">View Record</a>
                                        @if (!record.HasPrescription)
                                        {
                                            <a asp-action="CreatePrescription" asp-controller="Doctor" asp-route-visitRecordId="@record.Id" class="btn btn-sm btn-outline-success">+ Prescription</a>
                                        }
                                        else
                                        {
                                            <a asp-action="ViewPrescription" asp-controller="Doctor" asp-route-id="@record.PrescriptionId" class="btn btn-sm btn-outline-info">View Rx</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
