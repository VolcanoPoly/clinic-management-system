    Author      : Ali Alsaffar
    Student ID  : 202301152
    Stage       : Stage 7 - Visit Records & Prescriptions
    Description : Doctor view of a specific patient complete medical history, combining visit records and prescriptions across all doctors.
*@
@model ClinicMVC.Models.ViewModels.PatientHistoryViewModel
@{
    ViewData["Title"] = "Patient History";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Patient: @Model.PatientName</h5>
                    <a asp-action="MyAppointments" asp-controller="Doctor" class="btn btn-light btn-sm">← My Appointments</a>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <p class="text-muted small mb-1">EMAIL</p>
                            <p class="fw-semibold">@Model.PatientEmail</p>
                        </div>
                        <div class="col-md-4">
                            <p class="text-muted small mb-1">DATE OF BIRTH</p>
                            <p class="fw-semibold">@Model.DateOfBirth.ToString("dd MMM yyyy")</p>
                        </div>
                        <div class="col-md-4">
                            <p class="text-muted small mb-1">PHONE</p>
                            <p class="fw-semibold">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Visit Records -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Visit Records</h5>
                </div>
                <div class="card-body">
                    @if (Model.VisitRecords.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Doctor</th>
                                        <th>Diagnosis</th>
                                        <th>Prescription</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in Model.VisitRecords)
                                    {
                                        <tr>
                                            <td>@record.AppointmentDateTime.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>@record.DoctorName</td>
                                            <td>@record.Diagnosis</td>
                                            <td>
                                                @if (record.HasPrescription)
                                                {
                                                    <span class="badge bg-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">No</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="VisitRecordDetail" asp-controller="Doctor" asp-route-id="@record.Id" class="btn btn-sm btn-outline-primary">View</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No visit records found for this patient.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Prescriptions -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Prescriptions</h5>
                </div>
                <div class="card-body">
                    @if (Model.Prescriptions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date Issued</th>
                                        <th>Doctor</th>
                                        <th>Medications</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var prescription in Model.Prescriptions)
                                    {
                                        <tr>
                                            <td>@prescription.IssuedAt.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>@prescription.DoctorName</td>
                                            <td>@prescription.Items.Count medication(s)</td>
                                            <td>
                                                <a asp-action="ViewPrescription" asp-controller="Doctor" asp-route-id="@prescription.Id" class="btn btn-sm btn-outline-success">View</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No prescriptions found for this patient.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
