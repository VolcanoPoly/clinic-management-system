@{
    ViewData["Title"] = "MedCenter — Healthcare Clinic";
    ViewData["AuthPage"] = true;
}

<div class="landing-wrapper">

    <!-- ── Hero ──────────────────────────────────────────────────────────── -->
    <section class="landing-hero">
        <div class="landing-hero-inner">

            <div class="landing-logo-wrap" data-aos="zoom-in" data-aos-duration="600">
                <img src="~/images/logo.svg" alt="MedCenter" class="landing-logo float-anim" />
            </div>

            <h1 class="landing-headline" data-aos="fade-up" data-aos-delay="100">
                Your Health,<br><span class="landing-headline-accent">Our Priority.</span>
            </h1>

            <p class="landing-sub" data-aos="fade-up" data-aos-delay="200">
                MedCenter connects patients with trusted specialist doctors.<br>
                Book appointments, manage your visits, and track your health — all in one place.
            </p>

            <div class="landing-cta" data-aos="fade-up" data-aos-delay="300">
                <a asp-controller="Account" asp-action="Register" class="btn btn-landing-primary">
                    <i class="fa-solid fa-user-plus me-2"></i> Get Started — It's Free
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-landing-ghost">
                    <i class="fa-solid fa-right-to-bracket me-2"></i> Sign In
                </a>
                <a asp-controller="Lookup" asp-action="Index" class="btn btn-landing-ghost">
                    <i class="fa-solid fa-magnifying-glass me-2"></i> Lookup Appointment
                </a>
            </div>

            <!-- Scroll hint -->
            <div class="landing-scroll-hint" data-aos="fade-up" data-aos-delay="500">
                <i class="fa-solid fa-chevron-down"></i>
            </div>
        </div>
    </section>

    <!-- ── Features ──────────────────────────────────────────────────────── -->
    <section class="landing-features">
        <p class="landing-features-label" data-aos="fade-up">Everything you need</p>
        <h2 class="landing-features-title" data-aos="fade-up" data-aos-delay="60">
            A smarter way to manage your health
        </h2>

        <div class="landing-features-grid">

            <div class="landing-feature-card" data-aos="fade-up" data-aos-delay="0">
                <div class="lf-icon" style="background:rgba(59,130,246,0.15);color:#7dd3fc;">
                    <i class="fa-solid fa-calendar-plus"></i>
                </div>
                <h3>Easy Booking</h3>
                <p>Book appointments with specialist doctors in minutes — no waiting on hold.</p>
            </div>

            <div class="landing-feature-card" data-aos="fade-up" data-aos-delay="80">
                <div class="lf-icon" style="background:rgba(16,185,129,0.15);color:#6ee7b7;">
                    <i class="fa-solid fa-stethoscope"></i>
                </div>
                <h3>Specialist Doctors</h3>
                <p>Choose from a wide range of verified specialists across 10+ medical fields.</p>
            </div>

            <div class="landing-feature-card" data-aos="fade-up" data-aos-delay="160">
                <div class="lf-icon" style="background:rgba(139,92,246,0.15);color:#c4b5fd;">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <h3>Full History</h3>
                <p>Access your complete appointment and prescription history anytime.</p>
            </div>

            <div class="landing-feature-card" data-aos="fade-up" data-aos-delay="240">
                <div class="lf-icon" style="background:rgba(236,72,153,0.15);color:#f9a8d4;">
                    <i class="fa-solid fa-bell"></i>
                </div>
                <h3>Live Updates</h3>
                <p>Get real-time status notifications as your appointment progresses.</p>
            </div>

            <div class="landing-feature-card" data-aos="fade-up" data-aos-delay="320">
                <div class="lf-icon" style="background:rgba(245,158,11,0.15);color:#fcd34d;">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h3>Secure &amp; Private</h3>
                <p>Your data is protected with industry-standard encryption and access controls.</p>
            </div>

            <div class="landing-feature-card" data-aos="fade-up" data-aos-delay="400">
                <div class="lf-icon" style="background:rgba(14,165,233,0.15);color:#7dd3fc;">
                    <i class="fa-solid fa-mobile-screen"></i>
                </div>
                <h3>Works Everywhere</h3>
                <p>Fully responsive — use MedCenter on desktop, tablet, or mobile seamlessly.</p>
            </div>

        </div>
    </section>

    <!-- ── Bottom CTA ─────────────────────────────────────────────────────── -->
    <section class="landing-bottom-cta" data-aos="zoom-in" data-aos-delay="100">
        <h2>Ready to take control of your health?</h2>
        <p>Join MedCenter today and experience healthcare the modern way.</p>
        <a asp-controller="Account" asp-action="Register" class="btn btn-landing-primary btn-lg">
            <i class="fa-solid fa-user-plus me-2"></i> Create Your Free Account
        </a>
    </section>

</div>
