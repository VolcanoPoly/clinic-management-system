@{
    ViewData["Title"] = "Page Not Found";
}

<div class="not-found-wrapper">
    <div class="not-found-card" data-aos="fade-up">

        <div class="not-found-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
        </div>

        <h1 class="not-found-code">404</h1>
        <h2 class="not-found-title">Page Not Found</h2>
        <p class="not-found-sub">
            The page you're looking for doesn't exist or has been moved.<br />
            Please check the URL or navigate back to safety.
        </p>

        <div class="not-found-actions">
            <a href="/" class="btn btn-primary not-found-btn">
                <i class="fa-solid fa-house me-2"></i> Go to Home
            </a>
            <button onclick="history.back()" class="btn btn-outline-secondary not-found-btn">
                <i class="fa-solid fa-arrow-left me-2"></i> Go Back
            </button>
        </div>

    </div>
</div>

<style>
.not-found-wrapper {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
}

.not-found-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(14, 165, 233, 0.18);
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(14, 165, 233, 0.12), 0 4px 20px rgba(0,0,0,0.06);
    padding: 3rem 3.5rem;
    text-align: center;
    max-width: 480px;
    width: 100%;
}

.not-found-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1a6fc4, #0ea5e9);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    box-shadow: 0 8px 24px rgba(14, 165, 233, 0.35);
}

.not-found-icon i {
    font-size: 2rem;
    color: #fff;
}

.not-found-code {
    font-size: 5rem;
    font-weight: 800;
    background: linear-gradient(135deg, #1a6fc4, #0ea5e9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: 0.5rem;
}

.not-found-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.75rem;
}

.not-found-sub {
    color: #64748b;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 2rem;
}

.not-found-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
}

.not-found-btn {
    border-radius: 10px;
    padding: 0.55rem 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
}

.btn-primary.not-found-btn {
    background: linear-gradient(135deg, #1a6fc4, #0ea5e9);
    border: none;
    box-shadow: 0 4px 14px rgba(14, 165, 233, 0.35);
}

.btn-primary.not-found-btn:hover {
    background: linear-gradient(135deg, #155fa0, #0284c7);
    box-shadow: 0 6px 20px rgba(14, 165, 233, 0.45);
    transform: translateY(-1px);
}
</style>
