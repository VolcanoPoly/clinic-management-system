@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-dark text-white text-center p-4">
            <h1 class="display-4"><i class="bi bi-person-badge"></i></h1>
            <h3>Manager Portal</h3>
            <p>System-wide administration</p>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow-sm h-100 border-0 p-4">
            <h2 class="mb-4">System Overview</h2>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="p-3 border rounded">
                        <strong>Doctors:</strong> 2 Active
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 border rounded">
                        <strong>Patients:</strong> 2 Registered
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 border rounded">
                        <strong>Appointments:</strong> 5 Total
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 border rounded text-success">
                        <strong>System Status:</strong> Operational
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <button class="btn btn-dark disabled">Manage Doctors</button>
                <button class="btn btn-outline-dark disabled">System Logs</button>
            </div>
        </div>
    </div>
</div>
