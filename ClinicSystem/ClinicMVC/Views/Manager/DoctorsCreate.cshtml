@model DoctorFormViewModel

@{
    ViewData["Title"] = "Add Doctor";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2 class="mb-4">Create New Doctor</h2>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <strong>Please fix the following errors:</strong>
                    <ul class="mb-0">
                        @foreach (var key in ViewData.ModelState.Keys)
                        {
                            var modelState = ViewData.ModelState[key];
                            if (modelState.Errors.Count > 0)
                            {
                                foreach (var error in modelState.Errors)
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            }
                        }
                    </ul>
                </div>
            }

            <form method="post" class="needs-validation">
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="FirstName" class="form-label">First Name</label>
                        <input type="text" class="form-control" id="FirstName" asp-for="FirstName" required />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="LastName" class="form-label">Last Name</label>
                        <input type="text" class="form-control" id="LastName" asp-for="LastName" required />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="Email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="Email" asp-for="Email" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="LicenseNumber" class="form-label">License Number</label>
                    <input type="text" class="form-control" id="LicenseNumber" asp-for="LicenseNumber" required />
                    <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="Bio" class="form-label">Bio</label>
                    <textarea class="form-control" id="Bio" asp-for="Bio" rows="3"></textarea>
                    <span asp-validation-for="Bio" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Specializations</label>
                    <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                        @if (Model.AvailableSpecializations.Any())
                        {
                            foreach (var spec in Model.AvailableSpecializations)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="spec_@spec.Id" 
                                           name="SelectedSpecializationIds" value="@spec.Id" />
                                    <label class="form-check-label" for="spec_@spec.Id">
                                        @spec.Name
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No specializations available</p>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create Doctor</button>
                    <a asp-action="DoctorsIndex" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
