@model List<DoctorViewModel>

@{
    ViewData["Title"] = "Doctors";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Doctors Management</h2>
        <a asp-action="DoctorsCreate" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Doctor
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>License Number</th>
                        <th>Specializations</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in Model)
                    {
                        <tr>
                            <td>@doctor.FirstName</td>
                            <td>@doctor.LastName</td>
                            <td>@doctor.Email</td>
                            <td>@doctor.LicenseNumber</td>
                            <td>
                                @if (doctor.SpecializationNames.Any())
                                {
                                    foreach (var spec in doctor.SpecializationNames)
                                    {
                                        <span class="badge bg-info">@spec</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </td>
                            <td>
                                <a asp-action="DoctorsEdit" asp-route-id="@doctor.Id" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="SchedulesIndex" asp-route-doctorId="@doctor.Id" class="btn btn-sm btn-info">
                                    <i class="bi bi-calendar3"></i> Schedule
                                </a>
                                <form method="post" asp-action="DoctorsDelete" asp-route-id="@doctor.Id" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            data-confirm="Delete this doctor? This cannot be undone.">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> No doctors found. <a asp-action="DoctorsCreate">Create one</a>?
        </div>
    }
</div>
