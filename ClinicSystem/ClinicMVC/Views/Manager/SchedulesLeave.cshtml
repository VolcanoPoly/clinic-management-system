@model LeaveViewModel

@{
    ViewData["Title"] = "Manage Leave";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Leave Management for @Model.DoctorName</h2>
            <p class="text-muted">Mark doctor as unavailable on specific dates</p>
        </div>
        <a asp-action="SchedulesIndex" asp-route-doctorId="@Model.DoctorId" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Schedule
        </a>
    </div>

    <div class="row mb-5">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <strong>Add New Leave</strong>
                </div>
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong>Please fix the following errors:</strong>
                            <ul class="mb-0">
                                @foreach (var key in ViewData.ModelState.Keys)
                                {
                                    var modelState = ViewData.ModelState[key];
                                    if (modelState.Errors.Count > 0)
                                    {
                                        foreach (var error in modelState.Errors)
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                    }
                                }
                            </ul>
                        </div>
                    }

                    <form method="post" asp-action="SchedulesLeaveCreate" asp-route-doctorId="@Model.DoctorId" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="LeaveForm.StartDateString" class="form-label"></label>
                            <input asp-for="LeaveForm.StartDateString" type="date" class="form-control" />
                            <span asp-validation-for="LeaveForm.StartDateString" class="text-danger small"></span>
                            <div class="invalid-feedback">Start date is required.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LeaveForm.EndDateString" class="form-label"></label>
                            <input asp-for="LeaveForm.EndDateString" type="date" class="form-control" />
                            <span asp-validation-for="LeaveForm.EndDateString" class="text-danger small"></span>
                            <div class="invalid-feedback">End date is required.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LeaveForm.Reason" class="form-label">Reason (Optional)</label>
                            <textarea asp-for="LeaveForm.Reason" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="LeaveForm.Reason" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-plus-circle"></i> Add Leave
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <h3 class="mb-3">Leave History</h3>

    @if (Model.Leaves.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Reason</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leave in Model.Leaves)
                    {
                        <tr>
                            <td>@leave.StartDate.ToString("MMM dd, yyyy")</td>
                            <td>@leave.EndDate.ToString("MMM dd, yyyy")</td>
                            <td>@(string.IsNullOrEmpty(leave.Reason) ? "-" : leave.Reason)</td>
                            <td>
                                <form method="post" asp-action="SchedulesLeaveDelete" 
                                      asp-route-doctorId="@Model.DoctorId" asp-route-leaveId="@leave.Id" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            data-confirm="Remove this leave period?">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> No leave records found.
        </div>
    }
</div>

