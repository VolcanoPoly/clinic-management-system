@model List<ClinicMVC.Models.ViewModels.SpecializationViewModel>

@{
    ViewData["Title"] = "Specializations";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fa-solid fa-stethoscope me-2" style="color:#4338ca;"></i> Specializations</h2>
            <p class="text-muted mb-0">Manage the clinic's medical specialization catalogue.</p>
        </div>
        <button id="btnOpenCreate" type="button" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Add Specialization
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-center">Doctors</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var spec in Model)
                    {
                        <tr>
                            <td class="text-muted small">@spec.Id</td>
                            <td class="fw-semibold">@spec.Name</td>
                            <td class="text-muted">
                                @(string.IsNullOrWhiteSpace(spec.Description) ? "—" : spec.Description)
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">@spec.DoctorCount</span>
                            </td>
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-warning me-1 btn-open-edit"
                                        data-id="@spec.Id"
                                        data-name="@spec.Name"
                                        data-description="@spec.Description">
                                    <i class="fa-solid fa-pencil"></i> Edit
                                </button>
                                <form method="post" asp-action="SpecializationsDelete" asp-route-id="@spec.Id" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            data-confirm="Delete @spec.Name? This cannot be undone.">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fa-solid fa-circle-info me-2"></i> No specializations found. Add one to get started.
        </div>
    }

    <div class="mt-3">
        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SpecializationsCreate" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalLabel"><i class="fa-solid fa-plus me-2"></i> Add Specialization</h5>
                    <button type="button" class="btn-close" id="btnCloseCreate" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Cardiology" required maxlength="100" />
                        <div class="invalid-feedback">Name is required.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" class="form-control" rows="3"
                                  placeholder="Brief description of the specialization..." maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="btnCancelCreate">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-plus me-1"></i> Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SpecializationsEdit" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel"><i class="fa-solid fa-pencil me-2"></i> Edit Specialization</h5>
                    <button type="button" class="btn-close" id="btnCloseEdit" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" id="editName" class="form-control" required maxlength="100" />
                        <div class="invalid-feedback">Name is required.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" id="editDescription" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="btnCancelEdit">Cancel</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var createModalEl = document.getElementById('createModal');
        var editModalEl   = document.getElementById('editModal');

        var createModal = new bootstrap.Modal(createModalEl);
        var editModal   = new bootstrap.Modal(editModalEl);

        // Open create modal
        document.getElementById('btnOpenCreate').addEventListener('click', function () {
            createModal.show();
        });

        // Close buttons for create modal
        document.getElementById('btnCloseCreate').addEventListener('click', function () { createModal.hide(); });
        document.getElementById('btnCancelCreate').addEventListener('click', function () { createModal.hide(); });

        // Close buttons for edit modal
        document.getElementById('btnCloseEdit').addEventListener('click', function () { editModal.hide(); });
        document.getElementById('btnCancelEdit').addEventListener('click', function () { editModal.hide(); });

        // Open edit modal and populate fields
        document.querySelectorAll('.btn-open-edit').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('editId').value          = this.dataset.id;
                document.getElementById('editName').value        = this.dataset.name;
                document.getElementById('editDescription').value = this.dataset.description;
                editModal.show();
            });
        });
    })();
</script>
}
