@model List<ClinicMVC.Models.ViewModels.NotificationViewModel>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">
                <i class="fa-solid fa-bell me-2 text-primary"></i> Notifications
            </h2>
            @if (unreadCount > 0)
            {
                <small class="text-muted">@unreadCount unread</small>
            }
        </div>
        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="fa-solid fa-check-double me-1"></i> Mark all as read
                </button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5 text-muted">
                <i class="fa-solid fa-bell-slash fa-3x mb-3 opacity-25"></i>
                <p class="mb-0">No notifications yet.</p>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var n in Model)
            {
                <div class="card shadow-sm @(!n.IsRead ? "border-start border-primary border-3" : "opacity-75")">
                    <div class="card-body d-flex justify-content-between align-items-start py-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="mt-1">
                                @if (!n.IsRead)
                                {
                                    <span class="badge bg-primary rounded-pill" style="width:10px;height:10px;padding:0;display:inline-block;"></span>
                                }
                                else
                                {
                                    <span style="width:10px;height:10px;display:inline-block;"></span>
                                }
                            </div>
                            <div>
                                <p class="mb-1 @(!n.IsRead ? "fw-semibold" : "")">@n.Message</p>
                                <small class="text-muted">
                                    <i class="fa-regular fa-clock me-1"></i>
                                    @n.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </small>
                            </div>
                        </div>
                        <div class="d-flex gap-2 ms-3 flex-shrink-0">
                            @if (n.RelatedAppointmentId.HasValue)
                            {
                                <a asp-controller="Appointment" asp-action="Details" asp-route-id="@n.RelatedAppointmentId"
                                   class="btn btn-sm btn-outline-secondary">View</a>
                            }
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkRead" asp-route-id="@n.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-check"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
