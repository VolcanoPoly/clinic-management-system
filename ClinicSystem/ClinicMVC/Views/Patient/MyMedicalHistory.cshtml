    Author      : Ali Alsaffar
    Student ID  : 202301152
    Stage       : Stage 7 - Visit Records & Prescriptions
    Description : Patient-facing medical history page aggregating all their visit records and prescriptions in one place.
*@
@model ClinicMVC.Models.ViewModels.PatientHistoryViewModel
@{
    ViewData["Title"] = "My Medical History";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">My Medical History - @Model.PatientName</h5>
                </div>
                <div class="card-body">
                    <!-- Visit Records -->
                    <h6 class="mb-3">Visit Records</h6>
                    @if (Model.VisitRecords.Any())
                    {
                        <div class="table-responsive mb-4">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Doctor</th>
                                        <th>Diagnosis</th>
                                        <th>Prescription</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in Model.VisitRecords)
                                    {
                                        <tr>
                                            <td>@record.AppointmentDateTime.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>@record.DoctorName</td>
                                            <td>@record.Diagnosis</td>
                                            <td>
                                                @if (record.HasPrescription)
                                                {
                                                    <span class="badge bg-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">No</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="ViewVisitRecord" asp-route-id="@record.Id" class="btn btn-sm btn-outline-primary">View</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-4">No visit records found.</p>
                    }

                    <!-- Prescriptions -->
                    <h6 class="mb-3">Prescriptions</h6>
                    @if (Model.Prescriptions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date Issued</th>
                                        <th>Doctor</th>
                                        <th>Medications</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var prescription in Model.Prescriptions)
                                    {
                                        <tr>
                                            <td>@prescription.IssuedAt.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>@prescription.DoctorName</td>
                                            <td>@prescription.Items.Count medication(s)</td>
                                            <td>
                                                <a asp-action="ViewPrescription" asp-route-id="@prescription.Id" class="btn btn-sm btn-outline-success">View</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No prescriptions found.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
