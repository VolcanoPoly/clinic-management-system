@model ClinicMVC.Models.ViewModels.PrescriptionViewModel
@{
    ViewData["Title"] = "Prescription Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Prescription #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-4">
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Doctor:</strong> @Model.DoctorName
                            </div>
                            <div class="col-md-6">
                                <strong>Issued:</strong> @Model.IssuedAt.ToString("dd MMM yyyy HH:mm")
                            </div>
                        </div>
                    </div>

                    <h6 class="mb-3">Medications</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Medication</th>
                                    <th>Dosage</th>
                                    <th>Frequency</th>
                                    <th>Duration</th>
                                    <th>Instructions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@Model.Items[i].MedicationName</td>
                                        <td>@Model.Items[i].Dosage</td>
                                        <td>@Model.Items[i].Frequency</td>
                                        <td>@Model.Items[i].Duration</td>
                                        <td>@Model.Items[i].Instructions</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    <a asp-action="ViewVisitRecord" asp-controller="Patient" asp-route-id="@Model.VisitRecordId" class="btn btn-outline-secondary btn-sm w-100 mb-2">
                        ← View Visit Record
                    </a>
                    <a asp-action="MyMedicalHistory" class="btn btn-outline-primary btn-sm w-100 mb-2">
                        My Medical History
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
