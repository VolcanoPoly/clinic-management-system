@*
    Author      : Ali Alsaffar
    Student ID  : 202301152
    Stage       : Stage 7 - Visit Records & Prescriptions
    Description : Patient view of a single visit record, showing the doctor notes and treatment details from their appointment.
*@
@model ClinicMVC.Models.ViewModels.VisitRecordViewModel
@{
    ViewData["Title"] = "Visit Record Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8">
            <!-- Visit Record Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Visit Record #@Model.Id</h5>
                    <small class="text-muted">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p class="text-muted small">DOCTOR</p>
                            <p class="fw-semibold">@Model.DoctorName</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small">APPOINTMENT DATE</p>
                            <p class="fw-semibold">@Model.AppointmentDateTime.ToString("dddd, dd MMMM yyyy HH:mm")</p>
                        </div>
                    </div>

                    <div class="mb-4">
                        <p class="text-muted small">DIAGNOSIS</p>
                        <p class="fw-semibold text-primary">@Model.Diagnosis</p>
                    </div>

                    <div class="mb-4">
                        <p class="text-muted small">TREATMENT</p>
                        <p>@Model.Treatment</p>
                    </div>

                    <div class="mb-4">
                        <p class="text-muted small">DOCTOR NOTES</p>
                        <p>@Model.DoctorNotes</p>
                    </div>
                </div>
            </div>

            <!-- Prescription Card -->
            @if (Model.HasPrescription)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Prescription #@Model.PrescriptionId</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-3">A prescription has been issued for this visit.</p>
                        <a asp-action="ViewPrescription" asp-route-id="@Model.PrescriptionId" class="btn btn-success">
                            View Prescription
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Action Panel -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    <a asp-action="MyMedicalHistory" class="btn btn-outline-secondary btn-sm w-100 mb-2">
                        ← My Medical History
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
