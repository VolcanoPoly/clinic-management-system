@{
    ViewData["Title"] = "Receptionist Dashboard";
}

<div class="row mt-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body p-5">
                <h1 class="display-4">Receptionist Desk</h1>
                <p class="lead">Efficiently manage patient flow and bookings.</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4 g-4 text-center">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <i class="bi bi-calendar-plus display-4 text-info"></i>
                <h3 class="mt-2">New Booking</h3>
                <button class="btn btn-info text-white disabled">Open Form</button>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <i class="bi bi-person-check display-4 text-info"></i>
                <h3 class="mt-2">Check-In</h3>
                <button class="btn btn-info text-white disabled">Waiting Room</button>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <i class="bi bi-search display-4 text-info"></i>
                <h3 class="mt-2">Patient Search</h3>
                <button class="btn btn-info text-white disabled">Search</button>
            </div>
        </div>
    </div>
</div>
