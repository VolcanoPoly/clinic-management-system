@{
    ViewData["Title"] = "Receptionist Dashboard";
}

<div class="welcome-banner recept-banner" data-aos="fade-down">
    <div class="role-badge"><i class="fa-solid fa-headset"></i> Receptionist Desk</div>
    <h1><i class="fa-solid fa-desktop me-2"></i> Welcome, @User.Identity?.Name!</h1>
    <p>Efficiently manage patient flow, bookings, and check-ins.</p>
</div>

<div class="row g-4">
    <div class="col-md-4" data-aos="fade-up" data-aos-delay="0">
        <a asp-controller="Appointment" asp-action="Book" class="stat-card">
            <div class="stat-icon" style="background:#e0f2fe; color:#0369a1;">
                <i class="fa-solid fa-calendar-plus"></i>
            </div>
            <div class="stat-title">New Booking</div>
            <div class="stat-value">Book for Patient</div>
            <div class="stat-desc">Create a new appointment on behalf of a patient.</div>
            <div class="stat-action" style="color:#0369a1;">Open Form <i class="fa-solid fa-arrow-right"></i></div>
        </a>
    </div>

    <div class="col-md-4" data-aos="fade-up" data-aos-delay="80">
        <a asp-controller="Appointment" asp-action="TodaysAppointments" class="stat-card">
            <div class="stat-icon" style="background:#dbeafe; color:#1a6fc4;">
                <i class="fa-solid fa-person-walking-arrow-right"></i>
            </div>
            <div class="stat-title">Today's Appointments</div>
            <div class="stat-value">Check-In Patients</div>
            <div class="stat-desc">View today's schedule and manage patient arrivals.</div>
            <div class="stat-action">Waiting Room <i class="fa-solid fa-arrow-right"></i></div>
        </a>
    </div>

    <div class="col-md-4" data-aos="fade-up" data-aos-delay="160">
        <div class="stat-card" style="cursor:default; opacity:.65;">
            <div class="stat-icon" style="background:#f3f4f6; color:#9ca3af;">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <div class="stat-title">Patient Search</div>
            <div class="stat-value">Find a Patient</div>
            <div class="stat-desc">Search patient records and appointment history.</div>
            <div class="stat-action" style="color:#9ca3af;">Coming Soon <i class="fa-solid fa-clock"></i></div>
        </div>
    </div>
</div>
