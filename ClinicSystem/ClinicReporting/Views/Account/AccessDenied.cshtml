@{
    ViewData["Title"] = "Access Denied";
    ViewData["AuthPage"] = true;
}

<div class="auth-page auth-card shadow-lg rounded-4 p-5 text-center">
    <div class="mb-4">
        <i class="fa-solid fa-lock fa-3x text-warning"></i>
    </div>
    <h1 class="h4 mb-3">Access denied</h1>
    <p class="text-muted mb-4">Your account does not have permission to view this reporting portal.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Return to login</a>
</div>
