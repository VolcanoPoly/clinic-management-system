@model ClinicReporting.Models.AppointmentStatsViewModel
@{
    ViewData["Title"] = "Appointment Statistics";
}

<div class="my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">Appointment Statistics</h1>
            <p class="text-muted">Analyze appointment volumes, status counts, and specialization demand.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary me-2">Back to dashboard</a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">Logout</a>
        </div>
    </div>

    <form method="get" class="row g-3 mb-4">
        <div class="col-md-5">
            <label class="form-label">From</label>
            <input name="from" type="date" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-5">
            <label class="form-label">To</label>
            <input name="to" type="date" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2 d-grid align-self-end">
            <button type="submit" class="btn btn-primary">Refresh</button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    else
    {
        <div class="row gy-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm p-4">
                    <h5>Total appointments</h5>
                    <p class="display-6 mb-0">@Model.TotalAppointments</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm p-4">
                    <h5>Status breakdown</h5>
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.ByStatus.OrderByDescending(x => x.Value))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @item.Key
                                <span class="badge bg-primary rounded-pill">@item.Value</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm p-4">
                    <h5>Specialization demand</h5>
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.BySpecialization.OrderByDescending(x => x.Value))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @item.Key
                                <span class="badge bg-success rounded-pill">@item.Value</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
</div>
